  "item": [
    {
      "name": "1. GET 418 — немає в кеші (з http.cat)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: image/jpeg\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\"));",
              "pm.test(\"X-Cache: MISS\", () => pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"MISS\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
